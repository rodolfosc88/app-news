# Copie para .env e preencha. ATENÇÃO: toda variável VITE_* vai parar no
# JavaScript enviado ao navegador — qualquer visitante consegue lê-la.
VITE_API_URL=https://api.openweathermap.org/data
VITE_API_ID=sua_chave_openweather
VITE_API_URL_MAPBOX=https://api.mapbox.com/search/geocode/v6
VITE_API_MAPBOX_KEY=seu_token_publico_mapbox
